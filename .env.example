# Copy to .env for local development. Example values only; never commit real secrets or hostnames.

# Superuser created by the Postgres container. Used only by `npm run db:bootstrap` (roles, ownership) and test setup.
POSTGRES_USER=obur_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=obur
DATABASE_ADMIN_URL="postgres://obur_admin:change-me-admin@localhost:5432/obur"

# Schema owner: runs migrations only.
DATABASE_MIGRATOR_URL="postgres://obur_migrator:change-me-migrator@localhost:5432/obur"

# Runtime roles: non-superuser, no BYPASSRLS, own no tables.
DATABASE_URL="postgres://obur_app:change-me-app@localhost:5432/obur"
DATABASE_WORKER_URL="postgres://obur_worker:change-me-worker@localhost:5432/obur"
