#!/bin/bash
# Restoring obur from a backup (docs/restore.md). Two steps, so the service never reopens with restored sessions or
# with accounts that were deleted after the backup was taken:
#
#   obur-restore start [pgBackRest restore options]
#       With PostgreSQL stopped and an empty data folder: restores the latest backup and all archived WAL (or a point
#       in time with --type=time --target="2026-10-29 21:00:00+03"; use --repo=2 to restore from the off-site copy).
#
#   obur-restore finish --none | <account ID>[@<deletion date>] ...
#       With the restored database running: signs everyone out, cancels recovery links, unused invites and setup
#       links, deletes again each account from the admin's off-server deletion list (with its foods), and takes a full
#       backup of the new history (locally; the off-site copy too when it can be reached, otherwise with the next
#       nightly backup). Safe to run again after an interruption: each part does nothing the second time.
#
# Run both through `obur restore start|finish`, which keeps the restore's state (env.sh, RESTORE_STATE): the web app
# answers "restore in progress" until the restore is finished.
set -euo pipefail

STATUS_DIR=${OBUR_STATUS_DIR:-/var/lib/obur-status}
PGDATA=${PGBACKREST_PG1_PATH:-/var/lib/postgresql/18/docker}
UUID='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

say() { printf 'obur-restore: %s\n' "$*"; }
# The interruption test's stopping points (as in env.sh).
checkpoint() {
	if [[ ${OBUR_TEST_INTERRUPT:-} == "$1" ]]; then
		say "(test) stopped at $1" >&2
		exit 99
	fi
}
fail() {
	say "$*" >&2
	exit 1
}

start() {
	if [[ $(id -u) == 0 ]]; then
		install -d -o postgres -g postgres -m 700 "$PGDATA"
		install -d -o postgres -g postgres -m 755 "$STATUS_DIR"
		exec gosu postgres "$0" start "$@"
	fi
	if pg_isready -q -h /var/run/postgresql 2>/dev/null; then fail "PostgreSQL is running; use obur restore start"; fi
	if [[ -n $(ls -A "$PGDATA" 2>/dev/null) ]]; then
		fail "$PGDATA is not empty; use obur restore start, which moves it aside"
	fi
	say "restoring into $PGDATA ..."
	# Waits while the weekly restore check runs; none starts until this restore ends.
	obur-backup restore "$@"
	say "restored"
}

# The deletion list must be given, or --none said for an empty one: forgetting it would bring deleted accounts back
# (2026-11-21 audit, A10).
deletions_given() {
	if [[ ${1:-} == --none ]]; then
		[[ $# == 1 ]] || fail "--none means the deleted-accounts list is empty: pass either --none or the entries, not both"
	elif [[ $# == 0 ]]; then
		fail "pass every entry from Server → Backups → Deleted accounts, or --none if that list is empty (docs/restore.md)"
	fi
}

finish() {
	deletions_given "$@"
	[[ ${1:-} == --none ]] && shift
	local sql=(psql -X -q -v ON_ERROR_STOP=1 -h /var/run/postgresql -U "${PGBACKREST_PG1_USER:-postgres}" -d "${POSTGRES_DB:-obur}")
	local statements="begin;
delete from sessions;
update recovery_links set used_at = now() where used_at is null;
update invites set revoked_at = now() where used_at is null and revoked_at is null;
update bootstrap_tokens set used_at = now() where used_at is null;"
	# A backup from before foods became private (2026-11-17) still has the older function, which also asks whether
	# shared foods go. Lists from then mark that with ":shared"; foods kept there lose their owner and are removed by
	# the upgrade that follows once nobody else uses them.
	local older
	older=$("${sql[@]}" -tA -c "select to_regprocedure('app_reapply_deletion(uuid,timestamptz)') is null")
	local arg id shared at
	for arg in "$@"; do
		[[ $arg =~ ^($UUID)(:shared)?(@([0-9]{4}-[0-9]{2}-[0-9]{2}))?$ ]] || fail "not a deletion entry: $arg"
		id=${BASH_REMATCH[1]}
		shared=$([[ -n ${BASH_REMATCH[2]} ]] && echo true || echo false)
		at=$([[ -n ${BASH_REMATCH[4]:-} ]] && echo "'${BASH_REMATCH[4]}'::timestamptz" || echo 'now()')
		if [[ $older == t ]]; then
			statements+="
select app_reapply_deletion('$id', $shared, $at);"
		else
			statements+="
select app_reapply_deletion('$id', $at);"
		fi
	done
	statements+="
commit;"
	"${sql[@]}" <<<"$statements"
	say "signed everyone out, cancelled pending links and invites, reapplied $# deletion(s)"
	checkpoint finish-signed-out
	# A restore starts a new history (timeline); back it up in full before reopening. Only the local backup must
	# succeed: an unreachable off-site store must not keep obur closed (it is backed up in full when it answers).
	obur-backup full-local
	say "done"
}

case ${1:-} in
start)
	shift
	start "$@"
	;;
finish)
	shift
	[[ $(id -u) == 0 ]] && exec gosu postgres "$0" finish "$@"
	finish "$@"
	;;
*)
	echo "usage: obur-restore start [pgBackRest restore options] | finish --none | <id>[@YYYY-MM-DD] ..." >&2
	exit 2
	;;
esac
