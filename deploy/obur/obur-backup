#!/bin/bash
# Backups for the obur database with pgBackRest (docs/design.md, "Data safety, backups and restore").
#
# Repository 1 is local and always present; repository 2 is the optional off-site copy (S3-compatible, e.g.
# Cloudflare R2), configured through PGBACKREST_REPO2_* variables. Both are encrypted. WAL is archived continuously
# by PostgreSQL's archive_command. Results are written to $STATUS_FILE so the admin page can show them, including a
# plain warning when there is no off-site copy.
#
# The local repository never waits for the off-site one: each WAL file goes to the local repository first, and one
# the off-site store cannot take waits in a bounded queue ($QUEUE_DIR) that is sent when the store answers again.
#
#   obur-backup run            a backup now (full on the weekly full day or when none exists, otherwise differential)
#   obur-backup pre-upgrade    a quick incremental backup before an upgrade
#   obur-backup full           a full backup now (after a restore, which starts a new history)
#   obur-backup info           list backups
#   obur-backup restore-check  archive the current position, restore backup + WAL into a throwaway cluster, and
#                              verify it reached that position and every table reads
#   obur-backup scheduler      the nightly backup and weekly restore check (started by the container)
#   obur-backup archive-push <file>  archive one WAL file (PostgreSQL's archive_command, through pgbackrest-obur,
#                              since pgBackRest requires its name in the command)
#   obur-backup pgbackrest …    pgBackRest with this installation's settings
set -euo pipefail

STATUS_DIR=${OBUR_STATUS_DIR:-/var/lib/obur-status}
STATUS_FILE=$STATUS_DIR/backup.json
SOCKET=${PGBACKREST_PG1_SOCKET_PATH:-/var/run/postgresql}
BACKUP_HOUR=${OBUR_BACKUP_HOUR:-2}
FULL_DAY=${OBUR_FULL_BACKUP_DAY:-7}         # ISO weekday: 7 = Sunday
CHECK_DAY=${OBUR_RESTORE_CHECK_DAY:-7}
# WAL files waiting for the off-site store, compressed. Over the limit the queue is emptied: the off-site copy then
# cannot replay past that point until its next backup, which starts a complete history again.
QUEUE_DIR=${OBUR_OFFSITE_QUEUE_DIR:-/data/offsite-queue}
QUEUE_MAX_MB=${OBUR_OFFSITE_QUEUE_MAX_MB:-1024}
PSQL=(psql -X -q -t -A -h "$SOCKET" -U "${PGBACKREST_PG1_USER:-postgres}" -d postgres)

# The off-site repository exists only when configured: pgBackRest refuses empty settings, so they are passed on
# from OBUR_OFFSITE_* only when OBUR_OFFSITE_TYPE is set.
if [[ -n ${OBUR_OFFSITE_TYPE:-} ]]; then
	export PGBACKREST_REPO2_TYPE=$OBUR_OFFSITE_TYPE
	export PGBACKREST_REPO2_PATH=${OBUR_OFFSITE_PATH:-/obur}
	export PGBACKREST_REPO2_S3_ENDPOINT=${OBUR_OFFSITE_ENDPOINT:?}
	export PGBACKREST_REPO2_S3_BUCKET=${OBUR_OFFSITE_BUCKET:?}
	export PGBACKREST_REPO2_S3_REGION=${OBUR_OFFSITE_REGION:-auto}
	export PGBACKREST_REPO2_S3_KEY=${OBUR_OFFSITE_KEY:?}
	export PGBACKREST_REPO2_S3_KEY_SECRET=${OBUR_OFFSITE_SECRET:?}
	export PGBACKREST_REPO2_S3_URI_STYLE=path
	export PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
	export PGBACKREST_REPO2_CIPHER_PASS=$PGBACKREST_REPO1_CIPHER_PASS
	export PGBACKREST_REPO2_RETENTION_FULL=${PGBACKREST_REPO1_RETENTION_FULL:-5}
	export PGBACKREST_REPO2_BUNDLE=y
	export PGBACKREST_REPO2_BLOCK=y
fi

log() { printf '%s obur-backup: %s\n' "$(date -Iseconds)" "$*" >&2; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

repos() {
	echo 1
	if [[ -n ${PGBACKREST_REPO2_TYPE:-} ]]; then echo 2; fi
}

# Applies a jq filter (the last argument; earlier ones are jq options such as --arg) to the status file, atomically.
status() {
	local filter=${*: -1}
	set -- "${@:1:$#-1}"
	mkdir -p "$STATUS_DIR"
	# One writer at a time: the scheduler, the off-site queue and a backup run by hand all update this file.
	(
		flock 8
		local current='{}'
		if [[ -s $STATUS_FILE ]]; then current=$(cat "$STATUS_FILE"); fi
		jq --arg now "$(now)" --argjson offsite "$([[ -n ${PGBACKREST_REPO2_TYPE:-} ]] && echo true || echo false)" \
			"$@" "($filter) + {updatedAt: \$now, offsiteConfigured: \$offsite}" <<<"$current" >"$STATUS_FILE.tmp"
		mv "$STATUS_FILE.tmp" "$STATUS_FILE"
	) 8>"$STATUS_DIR/.backup.lock"
}

wait_ready() {
	until pg_isready -q -h "$SOCKET" -U "${PGBACKREST_PG1_USER:-postgres}" -d postgres; do sleep 5; done
}

# Runs pgBackRest as if no off-site repository were configured.
local_only() {
	(
		for v in $(compgen -e | grep '^PGBACKREST_REPO2_' || true); do unset "$v"; done
		pgbackrest "$@"
	)
}

# Runs pgBackRest with the off-site repository as its only one (a repository's number is only configuration).
offsite_only() {
	(
		local v
		for v in $(compgen -e | grep '^PGBACKREST_REPO1_' || true); do unset "$v"; done
		for v in $(compgen -e | grep '^PGBACKREST_REPO2_'); do
			export "PGBACKREST_REPO1_${v#PGBACKREST_REPO2_}=${!v}"
			unset "$v"
		done
		pgbackrest "$@"
	)
}

# The waiting files, oldest first. Files come and go while this looks (a WAL file arriving, another being sent), which
# find reports as a failure; the list it printed is still right.
queued() { { find "$QUEUE_DIR" -maxdepth 1 -name '*.gz' 2>/dev/null || true; } | sort; }

# PostgreSQL's archive_command. The local repository decides the result: PostgreSQL keeps a WAL file until this
# succeeds, so failing here because the off-site store is away would stop WAL reaching the local repository too
# (it did, before 1.0.0-beta.10). A file the off-site store does not take is queued instead; so is every file while
# others wait, without trying the store again each time.
archive_push() {
	local wal=$1 file name
	local_only archive-push "$wal" || return 1
	[[ -n ${PGBACKREST_REPO2_TYPE:-} ]] || return 0
	name=$(basename "$wal")
	if [[ -z $(queued | head -1) ]] && offsite_only archive-push "$wal" >/dev/null 2>&1; then return 0; fi
	file=$wal
	[[ $file == /* ]] || file=${PGBACKREST_PG1_PATH:-$PWD}/$file
	# A copy, never a link: PostgreSQL reuses the WAL file under a new name.
	if mkdir -p "$QUEUE_DIR" && gzip -1 -c "$file" >"$QUEUE_DIR/.$name.tmp" && sync "$QUEUE_DIR/.$name.tmp" &&
		mv "$QUEUE_DIR/.$name.tmp" "$QUEUE_DIR/$name.gz"; then
		local used
		used=$(du -sm "$QUEUE_DIR" | cut -f1)
		((used <= QUEUE_MAX_MB)) && return 0
		log "the off-site store has been away too long: $used MB of WAL waited for it (limit $QUEUE_MAX_MB MB)"
	else
		log "WAL file $name could not be kept for the off-site store"
	fi
	# The off-site history now has a hole. Say so until the next off-site backup, and keep nothing that needs it.
	find "$QUEUE_DIR" -maxdepth 1 \( -name '*.gz' -o -name '.*.tmp' \) -delete 2>/dev/null || true
	now >"$QUEUE_DIR/gap" 2>/dev/null || true
	return 0
}

# Sends the waiting WAL files to the off-site store, oldest first. Fails while any still wait.
drain_queue() {
	[[ -n ${PGBACKREST_REPO2_TYPE:-} && -n $(queued | head -1) ]] || return 0
	(
		flock 7
		work=$(mktemp -d "${TMPDIR:-/tmp}/offsite-queue.XXXXXX")
		trap 'rm -rf "$work"' EXIT
		sent=0
		while true; do
			item=$(queued | head -1)
			[[ -n $item ]] || break
			name=$(basename "$item" .gz)
			[[ -e $item ]] || continue
			gzip -dc "$item" >"$work/$name" || exit 1
			if ! out=$(offsite_only archive-push "$work/$name" 2>&1); then
				# Already there with other contents (an earlier attempt that did arrive): nothing more to send.
				[[ $out == *'ERROR: [045]'* ]] || exit 1
				log "WAL file $name is already in the off-site store; not sent again"
			fi
			rm -f "$item" "$work/$name"
			sent=$((sent + 1))
		done
		log "the off-site store is back: $sent waiting WAL file(s) sent"
	) 7>"$QUEUE_DIR/.lock"
}

# What waits for the off-site store, for the admin page. Written only when it changes.
queue_status() {
	local count oldest='' gap='' first line
	first=$(queued | head -1)
	count=$(queued | wc -l)
	[[ -n $first ]] && oldest=$(date -u -r "$first" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
	[[ -s $QUEUE_DIR/gap ]] && gap=$(cat "$QUEUE_DIR/gap")
	line="$count|$oldest|$gap"
	[[ $line == "${last_queue_status:-}" ]] && return 0
	last_queue_status=$line
	status --argjson n "$count" --arg o "$oldest" --arg g "$gap" \
		'.offsiteQueue = {waiting: $n, oldestAt: (if $o == "" then null else $o end),
			gapAt: (if $g == "" then null else $g end)}'
}

# Runs beside the scheduler and ends with it.
queue_loop() {
	local parent=$1
	while kill -0 "$parent" 2>/dev/null; do
		drain_queue || true
		queue_status || true
		sleep "${OBUR_OFFSITE_RETRY_SECONDS:-15}"
	done
}

# Idempotent: succeeds when the stanza already exists. stanza-create acts on every configured repository, so the
# local one is set up first on its own: an unreachable off-site store never stops local backups.
#
# One at a time: the scheduler and the backup before an upgrade both start with this when the container starts, and
# pgBackRest refuses a second stanza-create while one holds its lock (it held it for seconds while reaching the
# off-site store, and the upgrade's backup gave up: 1.0.0-beta.6 on a server with R2). A lock still busy (WAL being
# archived) is waited for too.
ensure_stanza() {
	(
		flock -w 900 9 || {
			log "the backup repository stayed busy for 15 minutes"
			exit 1
		}
		ensure_stanza_now
	) 9>"${TMPDIR:-/tmp}/obur-backup-stanza.lock"
}

ensure_stanza_now() {
	local out tries=0
	until out=$(local_only stanza-create 2>&1); do
		if [[ $out == *'ERROR: [050]'* ]] && ((++tries < 60)); then
			sleep 2
			continue
		fi
		log "the local repository could not be set up: $(grep -m3 -E 'ERROR|HINT' <<<"$out" | tr -s ' ' | tr '\n' ' ')"
		return 1
	done
	if [[ -n ${PGBACKREST_REPO2_TYPE:-} ]] && ! out=$(pgbackrest stanza-create 2>&1); then
		log "the off-site repository could not be set up (local backups continue): $(grep -m3 -E 'ERROR|HINT' <<<"$out" | tr -s ' ' | tr '\n' ' ')"
	fi
	return 0
}

archive_status() {
	local row
	row=$("${PSQL[@]}" -c "select coalesce(to_char(last_archived_time at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), ''),
		failed_count, coalesce(to_char(last_failed_time at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), '')
		from pg_stat_archiver" 2>/dev/null) || return 0
	IFS='|' read -r archived failed failed_at <<<"$row"
	status --arg a "$archived" --arg f "$failed_at" --argjson n "${failed:-0}" \
		'.archive = {lastArchivedAt: (if $a == "" then null else $a end), failedCount: $n,
			lastFailedAt: (if $f == "" then null else $f end)}'
}

# A backup of type $1 to every repository, or with "local" after it only to the local one, as if no off-site store
# were configured (the backup before an upgrade).
backup() {
	local type=$1 ok=true repo results='{}' started targets run=pgbackrest
	targets=$(repos)
	if [[ ${2:-} == local ]]; then
		targets=1
		run=local_only
	fi
	started=$(now)
	if ! ensure_stanza; then
		log "the local backup repository could not be set up; no backup was taken"
		status --arg at "$started" '.lastBackup = {at: $at, type: "none", ok: false, repos: {"1": false}}'
		return 1
	fi
	for repo in $targets; do
		# The off-site backup needs its WAL to arrive there, so what waits is sent first; if it cannot be, the
		# store is away and the backup would only time out.
		local reachable=true
		if [[ $repo == 2 ]] && ! drain_queue; then
			reachable=false
			log "the off-site store cannot be reached; WAL is waiting for it"
		fi
		if $reachable && $run --repo="$repo" --type="$type" backup; then
			# A finished off-site backup is complete in itself, whatever was lost before it.
			if [[ $repo == 2 ]]; then rm -f "$QUEUE_DIR/gap"; fi
			results=$(jq --arg r "$repo" '. + {($r): true}' <<<"$results")
		else
			ok=false
			results=$(jq --arg r "$repo" '. + {($r): false}' <<<"$results")
			log "backup to repository $repo failed"
		fi
	done
	status --arg at "$started" --arg type "$type" --argjson ok "$ok" --argjson repos "$results" \
		'.lastBackup = {at: $at, type: $type, ok: $ok, repos: $repos}
		| if $ok then .lastSuccessfulBackupAt = $at else . end'
	archive_status
	queue_status || true
	$ok
}

scheduled_type() {
	# A full backup on the weekly full day, otherwise differential (pgBackRest makes it full if none exists yet).
	if [[ $(date +%u) == "$FULL_DAY" ]]; then echo full; else echo diff; fi
}

# The obur container's access rules for the throwaway copy (the administrator as the postgres system user), when
# present; a copy restored from another setup otherwise keeps its own.
copy_access() {
	if [[ -f /etc/obur/pg_hba.conf ]]; then
		echo "-c hba_file=/etc/obur/pg_hba.conf -c ident_file=/etc/obur/pg_ident.conf"
	fi
}

# Restores into a throwaway cluster from repository $1 (1 local, 2 off-site) and records the result under $2.
restore_check_repo() {
	local repo=$1 key=$2 dir port=5499 started detail ok=false target segment
	started=$(now)
	dir=$(mktemp -d /tmp/restore-check.XXXXXX)
	# Cleans up when this function returns, then removes itself: a RETURN trap would otherwise fire again when the
	# calling function returns, where $dir no longer exists.
	trap 'pg_ctl -D "$dir" -m immediate stop >/dev/null 2>&1 || true; rm -rf "$dir"; trap - RETURN' RETURN
	# The recovery point to prove: the live database's current position, archived now. A marker is written first, so
	# there is always something to archive: on a quiet database sitting exactly at the start of a WAL file, closing
	# the file does nothing, and the check waited two minutes for a file that never came (seen 2026-11-13).
	"${PSQL[@]}" -c "select pg_create_restore_point('obur restore check')" >/dev/null
	target=$("${PSQL[@]}" -c 'select pg_current_wal_lsn()')
	segment=$("${PSQL[@]}" -c "select pg_walfile_name('$target')")
	"${PSQL[@]}" -c 'select pg_switch_wal()' >/dev/null
	local archived=''
	for _ in $(seq 60); do
		archived=$("${PSQL[@]}" -c 'select coalesce(last_archived_wal, $$$$) from pg_stat_archiver')
		[[ ${archived:0:24} > "$segment" || ${archived:0:24} == "$segment" ]] && break
		sleep 2
	done
	# Restore the latest backup plus all archived WAL from the repository. Archiving is off in the copy, so it can
	# never push WAL into the real repositories.
	if [[ ${archived:0:24} < "$segment" ]]; then
		detail="WAL up to $target was not archived within two minutes"
	elif [[ $repo == 2 ]] && ! drain_queue; then
		detail="the off-site store could not be reached; $(queued | wc -l) WAL file(s) wait to be sent"
	elif ! pgbackrest --repo="$repo" restore --pg1-path="$dir" --archive-mode=off --delta >/dev/null; then
		detail="restore failed"
	elif ! pg_ctl -D "$dir" -w -t 600 -l "$dir/restore.log" \
		-o "-p $port -c listen_addresses='' -c unix_socket_directories=$dir -c archive_mode=off $(copy_access)" start >/dev/null; then
		detail="restored copy did not start"
	else
		local q=(psql -X -q -t -A -h "$dir" -p "$port" -U "${PGBACKREST_PG1_USER:-postgres}")
		# Wait for recovery to finish, then read every table in the obur database completely.
		for _ in $(seq 150); do
			[[ $("${q[@]}" -d postgres -c 'select pg_is_in_recovery()') == f ]] && break
			sleep 2
		done
		local tables rows=0 table count failed='' reached checkpoint
		tables=$("${q[@]}" -d "${POSTGRES_DB:-obur}" -c "select format('%I.%I', schemaname, tablename)
			from pg_tables where schemaname in ('public', 'pgboss')") || failed='could not list tables'
		for table in $tables; do
			count=$("${q[@]}" -d "${POSTGRES_DB:-obur}" -c "select count(*) from $table") || {
				failed="could not read $table"
				break
			}
			rows=$((rows + count))
		done
		# The copy must have replayed up to the recovery point taken above.
		checkpoint=$("${q[@]}" -d postgres -c 'select checkpoint_lsn from pg_control_checkpoint()')
		reached=$("${q[@]}" -d postgres -c "select '$checkpoint'::pg_lsn >= '$target'::pg_lsn")
		if [[ -n $failed ]]; then
			detail=$failed
		elif [[ $reached != t ]]; then
			detail="restored copy stops at $checkpoint, before the recovery point $target"
		else
			ok=true
			detail="read $(wc -w <<<"$tables") tables, $rows rows; recovered to $checkpoint (target $target)"
		fi
	fi
	status --arg at "$started" --argjson ok "$ok" --arg detail "$detail" \
		".$key = {at: \$at, ok: \$ok, detail: \$detail}"
	log "restore check (repository $repo): $detail"
	$ok
}

# The local copy, then the off-site copy when one is configured: a backup nobody has restored is not yet a backup.
restore_check() {
	local ok=true
	restore_check_repo 1 lastRestoreCheck || ok=false
	if [[ -n ${PGBACKREST_REPO2_TYPE:-} ]]; then
		restore_check_repo 2 lastOffsiteRestoreCheck || ok=false
	fi
	$ok
}

scheduler() {
	wait_ready
	until ensure_stanza; do
		log "waiting to create the backup stanza"
		sleep 60
	done
	if [[ -n ${PGBACKREST_REPO2_TYPE:-} ]]; then queue_loop $$ & fi
	log "scheduler started (backups after ${BACKUP_HOUR}:00, restore check on weekday $CHECK_DAY)"
	while true; do
		local today hour last_backup last_check
		today=$(date +%F)
		hour=$((10#$(date +%H)))
		last_backup=$(jq -r '.lastBackup.at // ""' "$STATUS_FILE" 2>/dev/null || true)
		last_check=$(jq -r '.lastRestoreCheck.at // ""' "$STATUS_FILE" 2>/dev/null || true)
		# Status times are UTC; compare by the local date of the stored instant.
		local backup_day='' check_day=''
		[[ -n $last_backup ]] && backup_day=$(date -d "$last_backup" +%F)
		[[ -n $last_check ]] && check_day=$(date -d "$last_check" +%F)
		# A new installation is backed up straight away rather than at night.
		if [[ -z $last_backup ]] || { ((hour >= BACKUP_HOUR)) && [[ $backup_day != "$today" ]]; }; then
			backup "$(scheduled_type)" || true
		fi
		if [[ $(date +%u) == "$CHECK_DAY" ]] && ((hour >= BACKUP_HOUR)) && [[ $check_day != "$today" ]]; then
			restore_check || true
		fi
		archive_status || true
		sleep 600
	done
}

case ${1:-} in
pgbackrest)
	shift
	exec pgbackrest "$@"
	;;
archive-push) archive_push "${2:?}" ;;
run) backup "$(scheduled_type)" ;;
# Local only: the point to go back to if an upgrade goes wrong, quick, and never stopped by an unreachable off-site
# store. The nightly backup copies the upgraded database off site as usual.
pre-upgrade) backup incr local ;;
full) backup full ;;
info) pgbackrest info ;;
restore-check) restore_check ;;
scheduler) scheduler ;;
*)
	echo "usage: obur-backup run|pre-upgrade|full|info|restore-check|scheduler|archive-push <file>|pgbackrest <args>" >&2
	exit 2
	;;
esac
