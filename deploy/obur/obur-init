#!/bin/bash
# The obur container's main process (under tini): PostgreSQL, the backup scheduler, the web app and the worker, each
# as its own user. Start-up applies upgrades (with a backup first when there is history to protect), and a stop shuts
# everything down in order. Anything that dies unexpectedly stops the container, so Docker's restart policy restarts
# it whole. `obur restore start` asks for a hold (everything stopped) through $OBUR_RUN/hold. The restore's own state
# (env.sh, RESTORE_STATE) decides the rest: while it is restored or finishing, only the database and the web app's
# "being restored" page run; at reopening (after finish) the web app is stopped, the database set up and upgraded,
# then the step cleared and everything started; a restore that stopped before that (also across a restart) keeps everything stopped
# until `obur restore start` or `obur restore cancel`, so a half-written database folder is never started.
set -euo pipefail
# shellcheck source=deploy/obur/env.sh
. /usr/local/lib/obur/env.sh

log() { printf '%s obur: %s\n' "$(date -Iseconds)" "$*"; }

obur_env
install -d -m 755 "$OBUR_RUN"
echo $$ >"$OBUR_RUN/init.pid"
rm -f "$OBUR_RUN/hold" "$OBUR_RUN/held"

# Without a mounted /data, everything would live inside this container and go with it, and a replacement container
# whose mount is mistyped would quietly start an empty installation: obur stops instead (2026-11-21 audit, A13).
if ! mountpoint -q /data; then
	if [[ ${OBUR_ALLOW_UNMOUNTED_DATA:-} == 1 ]]; then
		log "WARNING: /data is not a mounted folder (OBUR_ALLOW_UNMOUNTED_DATA=1). Your data lives inside this container and is lost when it is removed."
	else
		log "/data is not a mounted folder, so obur does not start: map a folder or volume to /data (docs/install/troubleshooting.md)"
		exit 1
	fi
fi
# The database and the web app run as their own users, who must be able to pass through /data to their folders.
chmod a+x /data
install -d -o postgres -g postgres -m 700 /data/postgres /data/backups /data/offsite-queue
install -d -o postgres -g postgres -m 755 "$OBUR_STATUS_DIR"
chown postgres:postgres /data/backups
restore_migrate_marks

PG_ARGS=(postgres
	-c listen_addresses=127.0.0.1
	-c hba_file=/etc/obur/pg_hba.conf
	-c ident_file=/etc/obur/pg_ident.conf
	-c wal_level=replica
	-c archive_mode=on
	-c 'archive_command=pgbackrest-obur archive-push %p'
	-c "archive_timeout=${OBUR_ARCHIVE_TIMEOUT:-300}")

pg_pid='' sched_pid='' web_pid='' worker_pid='' migrated=0 stopping=0 reason=''

alive() { [[ -n ${1:-} ]] && kill -0 "$1" 2>/dev/null; }

stop_proc() {
	local pid=$1 name=$2
	alive "$pid" || return 0
	kill -TERM "$pid" 2>/dev/null || true
	for _ in $(seq 100); do
		alive "$pid" || {
			wait "$pid" 2>/dev/null || true
			return 0
		}
		sleep 0.1
	done
	log "$name did not stop in 10 s; stopping it hard"
	kill -KILL "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
}

stop_app() {
	stop_proc "$worker_pid" worker
	stop_proc "$web_pid" web
	worker_pid='' web_pid=''
}

stop_all() {
	stop_app
	stop_proc "$sched_pid" 'backup scheduler'
	sched_pid=''
	if alive "$pg_pid"; then
		gosu postgres pg_ctl -D "$PGDATA" stop -m fast -w -t 60 >/dev/null || stop_proc "$pg_pid" PostgreSQL
		wait "$pg_pid" 2>/dev/null || true
	fi
	pg_pid=''
}

fatal() {
	log "$*; stopping"
	stop_all
	exit 1
}

# Why obur must not create a new, empty database here, if it must not (docs/restore.md): it waits for a restore.
needs_restore() {
	[[ ! -s $PGDATA/PG_VERSION && ${OBUR_ALLOW_NEW_DATABASE:-} != 1 ]] || return 1
	if [[ -n $(restore_step) ]]; then
		echo "a restore is pending but the database folder is empty: run 'obur restore cancel', then 'obur restore start'"
	elif [[ -f /data/backups/backup/obur/backup.info ]]; then
		echo "the database folder is empty but backups exist: restore them with 'obur restore start' (docs/restore.md), or set OBUR_ALLOW_NEW_DATABASE=1 to start a new database"
	elif [[ $offsite == yes ]]; then
		echo "the database folder is empty and the off-site copy has backups: restore them with 'obur restore start --repo=2' (docs/restore.md), or set OBUR_ALLOW_NEW_DATABASE=1 to start a new database"
	elif [[ $offsite == unreachable ]]; then
		echo "the database folder is empty and the off-site store can't be reached to look for backups (tried again every minute): check the OBUR_OFFSITE_* settings, or set OBUR_ALLOW_NEW_DATABASE=1 to start a new database"
	else
		return 1
	fi
}

# What the off-site copy holds, looked up only while there is no database (a new server, or a lost one) and again
# each minute while the store can't be reached. A new server must never start an empty database beside backups
# it could restore: its own new backups would then refuse the restored one (2026-11-20 audit).
offsite='' offsite_at=0
look_offsite() {
	[[ -n ${OBUR_OFFSITE_TYPE:-}${PGBACKREST_REPO2_TYPE:-} && ! -s $PGDATA/PG_VERSION ]] || return 0
	[[ ${OBUR_ALLOW_NEW_DATABASE:-} != 1 && ! -f /data/backups/backup/obur/backup.info ]] || return 0
	[[ -z $offsite || ($offsite == unreachable && $(($(date +%s) - offsite_at)) -ge 60) ]] || return 0
	offsite=$(gosu postgres obur-backup offsite-backups 2>/dev/null) || offsite=unreachable
	offsite_at=$(date +%s)
}

start_pg() {
	install -d -o postgres -g postgres -m 700 "$(dirname "$PGDATA")"
	if [[ ! -s $PGDATA/PG_VERSION ]]; then
		log "creating a new database"
		gosu postgres initdb -D "$PGDATA" -U obur_admin --data-checksums --auth-local=peer \
			--auth-host=scram-sha-256 >/dev/null || fatal "creating the database failed"
	fi
	gosu postgres "${PG_ARGS[@]}" &
	pg_pid=$!
	# Recovery after a restore can take a while.
	for _ in $(seq 1200); do
		alive "$pg_pid" || fatal "PostgreSQL did not start"
		pg_isready -q -h 127.0.0.1 -U obur_app -d obur && break
		sleep 0.5
	done
	pg_isready -q -h 127.0.0.1 -U obur_app -d obur || fatal "PostgreSQL did not become ready"
	# Looked for on every start, not only the one that ran initdb: a first start stopped between the two left a
	# database without obur's, and every later start failed (2026-11-25 audit). A restored one always has it, so
	# nothing is written while it replays its history.
	local found
	found=$(gosu postgres psql -X -q -t -A -v ON_ERROR_STOP=1 -h "$OBUR_SOCKET" -U obur_admin -d postgres \
		-c "select count(*) from pg_database where datname = 'obur'") || fatal "PostgreSQL did not answer"
	if [[ $found == 0 ]]; then
		gosu postgres psql -X -q -v ON_ERROR_STOP=1 -h "$OBUR_SOCKET" -U obur_admin -d postgres \
			-c 'create database obur' || fatal "creating the database failed"
	fi
	log "database ready"
}

start_scheduler() {
	gosu postgres env TZ="${TZ:-UTC}" OBUR_BACKUP_HOUR="${OBUR_BACKUP_HOUR:-2}" obur-backup scheduler &
	sched_pid=$!
}

# Whether this obur is older than its database (a rollback): it was never tested on that database, which can lack
# what it needs (beta.19 on a database without foods.visibility), so it doesn't open, and the database stays as it
# is (2026-11-20 audit, R12; before, it opened anyway). The fix is the newer version, or the backup taken before the
# update. Prints the reason when it is.
older_than_database() {
	local known applied
	known=$(jq '.entries | length' /app/drizzle/meta/_journal.json) || return 1
	[[ $(obur_psql -c "select to_regclass('public.schema_migrations') is not null") == t ]] || return 1
	applied=$(obur_psql -c 'select count(*) from schema_migrations') || return 1
	((applied > known)) || return 1
	echo "this obur is older than its database ($applied database steps, this version knows $known): it does not open. Start the newer version again, or restore the backup taken before the update (docs/install/updating.md)"
}

upgrade() {
	local known applied
	# This installation's own administrator password (also after a restore or a move from another setup). Here and
	# not at start-up: a restored database accepts connections while it is still replaying its history, read-only,
	# and this runs only once a restore is finished (`obur restore finish` waits for the replay).
	obur_psql >/dev/null <<<"alter role obur_admin password '$OBUR_ADMIN_DB_PASSWORD'"
	known=$(jq '.entries | length' /app/drizzle/meta/_journal.json)
	applied=-1
	if [[ $(obur_psql -c "select to_regclass('public.schema_migrations') is not null") == t ]]; then
		applied=$(obur_psql -c 'select count(*) from schema_migrations')
	fi
	# Every upgrade of an existing database takes a backup first, also when the local repository is missing (a new
	# backup disk, a mount typo): it is set up again and the backup is then a full one. A repository that can't be
	# used stops the upgrade (2026-11-21 audit, A03).
	if ((applied >= 0 && applied < known)); then
		log "upgrading the database ($((known - applied)) step(s)); taking a backup first (a full one if there is none)"
		gosu postgres obur-backup pre-upgrade ||
			fatal "the backup before the upgrade failed, so nothing was changed: check that /data/backups can be written"
	fi
	# As the database's own system user, through the socket: the only way the administrator may sign in.
	(cd /app && env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp DATABASE_ADMIN_SOCKET="$OBUR_SOCKET" \
		DATABASE_ADMIN_URL=postgres://obur_admin@localhost/obur DATABASE_MIGRATOR_URL="$OBUR_MIGRATOR_URL" \
		DATABASE_URL="$OBUR_APP_URL" DATABASE_WORKER_URL="$OBUR_WORKER_URL" \
		gosu postgres node scripts/db-bootstrap.ts >/dev/null) || fatal "setting up database roles failed"
	obur_node migrate.ts || fatal "the database upgrade failed (it was rolled back)"
	TZ=${TZ:-UTC} obur_node jobs-setup.ts >/dev/null || fatal "setting up background jobs failed"
	obur_node curated-load.ts >/dev/null || fatal "loading the curated foods failed"
	if [[ $(obur_psql -c 'select count(*) from users') == 0 ]]; then
		log "no account exists yet. Open this link on the device you will use first (valid for 24 hours, works once):"
		obur_node admin-setup-link.ts | tail -1
		log "a new link: docker exec <container> obur setup-link"
	fi
}

app_env() {
	exec env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp TZ="${TZ:-UTC}" NODE_ENV=production "$@"
}

# ORIGIN: the web server builds every request's address from the same PUBLIC_ORIGIN the passkey and form checks
# use, never from a proxy's Host or protocol headers, so the two can't disagree (2026-11-21 audit, A31).
start_web() {
	(cd /app && app_env PORT=3000 BODY_SIZE_LIMIT=21M ORIGIN="$PUBLIC_ORIGIN" \
		PUBLIC_ORIGIN="$PUBLIC_ORIGIN" WEBAUTHN_RP_ID="$WEBAUTHN_RP_ID" DATABASE_URL="$OBUR_APP_URL" \
		OBUR_STATUS_DIR="$OBUR_STATUS_DIR" SPEECH_URL="${SPEECH_URL:-}" LABELS_URL="${LABELS_URL:-}" \
		VAPID_PUBLIC_KEY="$VAPID_PUBLIC_KEY" OBUR_SECRETS_KEY="$OBUR_SECRETS_KEY" \
		OBUR_TRUSTED_PROXIES="${OBUR_TRUSTED_PROXIES:-}" OBUR_PREVIEW_LANGUAGES="${OBUR_PREVIEW_LANGUAGES:-}" \
		gosu node node server.js) &
	web_pid=$!
}

# Its own system user (2026-11-21 audit, A32): the web app and the worker can't read each other's settings (database
# passwords, the reminder signing key) from the other's process.
start_worker() {
	(cd /app && app_env DATABASE_WORKER_URL="$OBUR_WORKER_URL" WORKER_CONCURRENCY="${WORKER_CONCURRENCY:-1}" \
		VAPID_PUBLIC_KEY="$VAPID_PUBLIC_KEY" VAPID_PRIVATE_KEY="$VAPID_PRIVATE_KEY" VAPID_SUBJECT="$VAPID_SUBJECT" \
		OBUR_PREVIEW_LANGUAGES="${OBUR_PREVIEW_LANGUAGES:-}" gosu obur-worker node scripts/worker.ts) &
	worker_pid=$!
}

trap 'stopping=1' TERM INT

log "starting (data in /data)"
while :; do
	if ((stopping)); then
		log "stopping"
		stop_all
		exit 0
	fi
	if [[ -f $OBUR_RUN/hold ]]; then
		# A restore asked for everything to stop.
		if [[ -n $pg_pid$web_pid$worker_pid$sched_pid ]]; then
			log "stopping for a restore"
			stop_all
			migrated=0
		fi
		touch "$OBUR_RUN/held"
	elif [[ $(restore_step) =~ ^(preparing|moved|restoring|cancelling)$ ]]; then
		# A restore command stopped part-way (or the container restarted under it): nothing may run on that folder.
		if [[ -n $pg_pid$web_pid$worker_pid$sched_pid ]]; then
			stop_all
			migrated=0
		fi
		[[ -f $OBUR_RUN/held ]] ||
			log "waiting: a restore stopped at '$(restore_step)': run 'obur restore start' to try it again, or 'obur restore cancel' to go back"
		touch "$OBUR_RUN/held"
	elif [[ -z $pg_pid ]] && look_offsite && reason=$(needs_restore); then
		# Nothing runs; `obur restore start` can begin straight away.
		[[ -f $OBUR_RUN/held ]] || log "waiting: $reason"
		touch "$OBUR_RUN/held"
	else
		rm -f "$OBUR_RUN/held"
		if [[ -z $pg_pid ]]; then
			start_pg
			start_scheduler
		fi
		alive "$pg_pid" || fatal "PostgreSQL stopped unexpectedly"
		alive "$sched_pid" || start_scheduler
		if [[ $(restore_step) =~ ^(restored|finishing)$ ]]; then
			# Only the page that says a restore is in progress, until `obur restore finish`.
			if [[ -n $worker_pid ]]; then
				stop_proc "$worker_pid" worker
				worker_pid=''
			fi
			migrated=0
			[[ -n $web_pid ]] || start_web
		elif [[ $(restore_step) == reopening ]] || ((!migrated)); then
			# After `obur restore finish` the web app still shows the restore page: it is stopped, the restored
			# database gets this installation's roles and its upgrade, and only then the step is cleared (G23).
			stop_app
			migrated=1
			if reason=$(older_than_database); then
				log "$reason"
				[[ $(restore_step) != reopening ]] || restore_clear
			else
				upgrade
				[[ $(restore_step) != reopening ]] || restore_clear
				start_web
				start_worker
				log "ready on port 3000 for $PUBLIC_ORIGIN"
			fi
		fi
		if [[ -n $web_pid ]] && ! alive "$web_pid"; then fatal "the web app stopped unexpectedly"; fi
		if [[ -n $worker_pid ]] && ! alive "$worker_pid"; then fatal "the worker stopped unexpectedly"; fi
	fi
	sleep 1 &
	wait $! || true
done
