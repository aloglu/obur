#!/bin/bash
# obur's commands. The container runs `obur start`; operators run the others with `docker exec <container> obur …`:
#
#   obur setup-link                  a one-time link for the first account (24 hours)
#   obur recovery-link "<name|ID>"   a one-time link for someone who lost every passkey and code (1 hour)
#   obur backup now|pre-upgrade|info|restore-check
#   obur restore start [options]     replace the database with one restored from the backups (docs/restore.md)
#   obur restore finish [deletions]  sign everyone out, reapply deletions, back up, reopen
#   obur restore cancel              go back to before `restore start` (also after a failed one)
set -euo pipefail
# shellcheck source=deploy/obur/env.sh
. /usr/local/lib/obur/env.sh

usage() {
	sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
}

[[ $(id -u) == 0 ]] || obur_fail "run obur commands as root (docker exec runs as root by default)"

supervised() {
	[[ -f $OBUR_RUN/init.pid ]] && kill -0 "$(cat "$OBUR_RUN/init.pid")" 2>/dev/null ||
		obur_fail "obur is not running in this container"
}

# Where `restore start` moved the database it replaced, kept in /data so a restart doesn't lose it.
ASIDE_NOTE=$OBUR_STATUS_DIR/restore-aside

# A restore that completed and waits for `restore finish` (a mark without restoredAt is a failed attempt).
restore_completed() {
	jq -e '.restoredAt' "$OBUR_STATUS_DIR/restore-pending" >/dev/null 2>&1
}

hold_obur() {
	touch "$OBUR_RUN/hold"
	for _ in $(seq 120); do
		[[ -f $OBUR_RUN/held ]] && return 0
		sleep 1
	done
	return 1
}

# One restore command at a time: a second `start` or a `cancel` while one is still restoring would remove the
# database it is writing (2026-11-20 audit). Holding the lock also tells a running command from an interrupted one:
# a mark without restoredAt found while holding it is a failed or interrupted attempt. Held until this command ends.
restore_lock() {
	exec 9>"$OBUR_RUN/restore.lock"
	flock -n 9 || obur_fail "another 'obur restore' command is still running; wait for it to end, then try again"
}

move_aside() {
	mv "$PGDATA" "$1"
	sync /data
	echo "obur: the current database was moved aside to $1 (kept until you delete it)"
}

restore_start() {
	supervised
	restore_lock
	local retry=0
	if [[ -f $OBUR_STATUS_DIR/restore-pending ]]; then
		restore_completed && obur_fail "a restore is already pending: finish it with 'obur restore finish', or put the old database back with 'obur restore cancel'"
		retry=1
	elif [[ -f $ASIDE_NOTE ]]; then
		# An attempt that stopped before it began restoring: the database it replaced is aside already.
		retry=1
	fi
	echo "obur: stopping obur for the restore ..."
	hold_obur || {
		rm -f "$OBUR_RUN/hold"
		obur_fail "obur did not stop within two minutes; nothing was changed"
	}
	local aside
	aside=$(cat "$ASIDE_NOTE" 2>/dev/null || true)
	if ((retry)) && [[ -n $aside && ! -d $aside && -d $PGDATA ]]; then
		# Stopped after it noted where the database goes but before the move: the database is still in place.
		echo "obur: an earlier restore stopped before it began; starting it again"
		move_aside "$aside"
	elif ((retry)); then
		# The database folder holds only what the failed attempt left; the one it replaced is still aside.
		echo "obur: an earlier restore did not complete; starting it again"
		rm -rf "$PGDATA"
	elif [[ -d $PGDATA ]]; then
		aside=/data/postgres-before-restore-$(date +%Y%m%d-%H%M%S)
		# The note first, on disk before the move: an interruption at any point leaves the database findable, in its
		# place or at the noted path (2026-11-21 audit, A04). A rename within /data is all or nothing.
		echo "$aside" >"$ASIDE_NOTE.new"
		sync "$ASIDE_NOTE.new"
		mv "$ASIDE_NOTE.new" "$ASIDE_NOTE"
		sync "$OBUR_STATUS_DIR"
		move_aside "$aside"
	fi
	if ! obur-restore start "$@"; then
		echo "obur: the restore failed; obur stays stopped. Fix the cause and run 'obur restore start' again," >&2
		echo "obur: or go back to how it was with 'obur restore cancel'." >&2
		exit 1
	fi
	rm -f "$OBUR_RUN/hold"
	echo "obur: restored. obur now says it is being restored until you run:"
	echo "      obur restore finish <every entry from Members → Deleted accounts>"
}

restore_finish() {
	supervised
	restore_lock
	[[ -f $OBUR_STATUS_DIR/restore-pending ]] || obur_fail "no restore is pending"
	for _ in $(seq 120); do
		pg_isready -q -h "$OBUR_SOCKET" -U obur_admin -d obur && break
		sleep 1
	done
	# Accepting connections is not enough: until the restored database has replayed its archived WAL it is read-only,
	# and signing everyone out would fail (seen on a fast machine, 2026-11-15).
	echo "obur: waiting for the restored database to finish replaying its history ..."
	local recovering=t
	for _ in $(seq 600); do
		recovering=$(obur_psql -c 'select pg_is_in_recovery()' 2>/dev/null || echo t)
		[[ $recovering == f ]] && break
		sleep 1
	done
	[[ $recovering == f ]] || obur_fail "the restored database is still replaying after 10 minutes; run 'obur restore finish' again later"
	obur-restore finish "$@"
	rm -f "$ASIDE_NOTE" "$OBUR_RUN/aside"
	echo "obur: obur reopens in a few seconds. Then check Members → Backups, and run: obur backup restore-check"
}

restore_cancel() {
	supervised
	restore_lock
	[[ -f $OBUR_STATUS_DIR/restore-pending || -f $ASIDE_NOTE || -f $OBUR_RUN/aside ]] ||
		obur_fail "no restore is pending"
	local aside
	# $OBUR_RUN/aside: where versions before 1.0.0 noted it.
	aside=$(cat "$ASIDE_NOTE" 2>/dev/null || cat "$OBUR_RUN/aside" 2>/dev/null || true)
	hold_obur || obur_fail "obur did not stop within two minutes"
	if [[ -n $aside && -d $aside ]]; then
		rm -rf "$PGDATA"
		mv "$aside" "$PGDATA"
		echo "obur: the database from before the restore is back; obur starts again."
	elif [[ -n $aside ]]; then
		# Noted but never moved (the restore stopped before the move): the database never left its place.
		echo "obur: the restore stopped before it moved the database, so it is still in place; obur starts again."
	else
		rm -rf "$PGDATA"
		# Nothing was moved aside: there was no database before the restore.
		echo "obur: the restore is cancelled. There was no database before it, so obur is back to how it was then."
	fi
	rm -f "$OBUR_STATUS_DIR/restore-pending" "$ASIDE_NOTE" "$OBUR_RUN/aside" "$OBUR_RUN/hold"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
start) exec /usr/local/lib/obur/obur-init ;;
setup-link)
	obur_env
	obur_node admin-setup-link.ts
	;;
recovery-link)
	obur_env
	obur_node admin-recovery-link.ts "$@"
	;;
backup)
	obur_env
	case ${1:-} in
	now) exec gosu postgres obur-backup run ;;
	pre-upgrade) exec gosu postgres obur-backup pre-upgrade ;;
	info) exec gosu postgres obur-backup info ;;
	restore-check) exec gosu postgres obur-backup restore-check ;;
	*) usage ;;
	esac
	;;
restore)
	obur_env
	sub=${1:-}
	[[ $# -gt 0 ]] && shift
	case $sub in
	start) restore_start "$@" ;;
	finish) restore_finish "$@" ;;
	cancel) restore_cancel ;;
	*) usage ;;
	esac
	;;
*) usage ;;
esac
