#!/bin/bash
# obur's commands. The container runs `obur start`; operators run the others with `docker exec <container> obur …`:
#
#   obur setup-link                  a one-time link for the first account (24 hours)
#   obur recovery-link "<name|ID>"   a one-time link for someone who lost every passkey and code (1 hour)
#   obur backup now|pre-upgrade|info|restore-check
#   obur restore start [options]     replace the database with one restored from the backups (docs/restore.md)
#   obur restore finish <deletions>|--none  sign everyone out, reapply deletions, back up, reopen
#   obur restore cancel              go back to before `restore start` (also after a failed one)
set -euo pipefail
# shellcheck source=deploy/obur/env.sh
. /usr/local/lib/obur/env.sh

usage() {
	sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
}

[[ $(id -u) == 0 ]] || obur_fail "run obur commands as root (docker exec runs as root by default)"

supervised() {
	[[ -f $OBUR_RUN/init.pid ]] && kill -0 "$(cat "$OBUR_RUN/init.pid")" 2>/dev/null ||
		obur_fail "obur is not running in this container"
}

hold_obur() {
	touch "$OBUR_RUN/hold"
	for _ in $(seq 120); do
		[[ -f $OBUR_RUN/held ]] && return 0
		sleep 1
	done
	return 1
}

# One restore command at a time: a second `start` or a `cancel` while one is still restoring would remove the
# database it is writing (2026-11-20 audit). Held until this command ends. Every command then reads the one state
# (env.sh, RESTORE_STATE) and acts only on the steps it is for.
restore_lock() {
	exec 9>"$OBUR_RUN/restore.lock"
	flock -n 9 || obur_fail "another 'obur restore' command is still running; wait for it to end, then try again"
	restore_migrate_marks
}

stop_for_restore() {
	echo "obur: stopping obur for the restore ..."
	hold_obur || {
		rm -f "$OBUR_RUN/hold"
		obur_fail "obur did not stop within two minutes; nothing was changed"
	}
}

restore_start() {
	supervised
	restore_lock
	local step aside
	step=$(restore_step)
	case $step in
	restored) obur_fail "a restore is already pending: finish it with 'obur restore finish', or put the old database back with 'obur restore cancel'" ;;
	finishing) obur_fail "a restore is being finished: run 'obur restore finish' again to complete it" ;;
	cancelling) obur_fail "a restore is being cancelled: run 'obur restore cancel' again to complete it" ;;
	esac
	# A running restore check reads the live database: stopping it would record a failed check that is not one.
	gosu postgres obur-backup wait-restore-check
	stop_for_restore
	if [[ -z $step ]]; then
		# Where the current database goes, on disk before it moves; none when the folder holds no database.
		aside=''
		[[ -d $PGDATA ]] && aside=/data/postgres-before-restore-$(date +%Y%m%d-%H%M%S)
		restore_set preparing --arg aside "$aside" '. + {aside: $aside}'
		step=preparing
	else
		echo "obur: an earlier restore did not complete (it stopped at '$step'); starting it again"
	fi
	aside=$(restore_field aside)
	checkpoint start-prepared
	if [[ $step == preparing ]]; then
		# A rename within /data is all or nothing: the database is either still in place or wholly at `aside`.
		if [[ -n $aside && ! -d $aside ]]; then
			[[ -d $PGDATA ]] || obur_fail "the database to move aside is not at $PGDATA; nothing was changed"
			mv "$PGDATA" "$aside"
			sync /data
		fi
		[[ -n $aside ]] && echo "obur: the current database was moved aside to $aside (kept until you delete it)"
		checkpoint start-moved-unrecorded
		restore_set moved
		step=moved
	fi
	checkpoint start-moved
	# The database folder now holds at most what an earlier attempt restored: the database it replaced is at `aside`.
	restore_set restoring
	rm -rf "$PGDATA"
	checkpoint start-cleared
	if ! obur-restore start "$@"; then
		echo "obur: the restore failed; obur stays stopped. Fix the cause and run 'obur restore start' again," >&2
		echo "obur: or go back to how it was with 'obur restore cancel'." >&2
		exit 1
	fi
	checkpoint start-restored-unrecorded
	restore_set restored --arg options "$*" '. + {options: $options}'
	rm -f "$OBUR_RUN/hold"
	echo "obur: restored. obur now says it is being restored until you run:"
	echo "      obur restore finish <every entry from Server → Backups → Deleted accounts>   (or --none if that list is empty)"
}

restore_finish() {
	supervised
	# Checked before any waiting and before the restore is marked as finishing (obur-restore checks it again).
	obur-restore check-deletions "$@" || exit 1
	restore_lock
	case $(restore_step) in
	restored | finishing) ;;
	reopening)
		echo "obur: the restore is already finished; obur reopens in a few seconds"
		return
		;;
	'') obur_fail "no restore is pending" ;;
	cancelling) obur_fail "a restore is being cancelled: run 'obur restore cancel' again to complete it" ;;
	*) obur_fail "the restore did not complete (it stopped at '$(restore_step)'): run 'obur restore start' again, or 'obur restore cancel'" ;;
	esac
	for _ in $(seq 120); do
		pg_isready -q -h "$OBUR_SOCKET" -U obur_admin -d obur && break
		sleep 1
	done
	# Accepting connections is not enough: until the restored database has replayed its archived WAL it is read-only,
	# and signing everyone out would fail (seen on a fast machine, 2026-11-15).
	echo "obur: waiting for the restored database to finish replaying its history ..."
	local recovering=t
	for _ in $(seq 600); do
		recovering=$(obur_psql -c 'select pg_is_in_recovery()' 2>/dev/null || echo t)
		[[ $recovering == f ]] && break
		sleep 1
	done
	[[ $recovering == f ]] || obur_fail "the restored database is still replaying after 10 minutes; run 'obur restore finish' again later"
	# From here the restored database is the one kept: cancel is refused, and an interrupted finish is run again.
	restore_set finishing
	checkpoint finish-started
	obur-restore finish "$@"
	checkpoint finish-done-unrecorded
	local aside
	aside=$(restore_field aside)
	# Not cleared here: obur-init stops the web app, sets up the restored database's roles and upgrades it, and only
	# then clears the step and reopens, so no request reaches it before (2026-11-23 verification of G23).
	restore_set reopening
	echo "obur: obur reopens in a few seconds. Then check Server → Backups, and run: obur backup restore-check"
	[[ -z $aside || ! -d $aside ]] || echo "obur: the database from before the restore stays at $aside until you delete it"
}

restore_cancel() {
	supervised
	restore_lock
	local step aside
	step=$(restore_step)
	case $step in
	'' | reopening) obur_fail "no restore is pending (the last one is finished)" ;;
	finishing) obur_fail "the restore is being finished, so the restored database is the one kept: run 'obur restore finish' again to complete it" ;;
	esac
	aside=$(restore_field aside)
	stop_for_restore
	if [[ $step == preparing && ( -z $aside || ! -d $aside ) ]]; then
		# Stopped before the move: the database never left its place.
		restore_clear
		rm -f "$OBUR_RUN/hold"
		echo "obur: the restore stopped before it moved the database, so it is still in place; obur starts again."
		return
	fi
	restore_set cancelling
	checkpoint cancel-started
	if [[ -n $aside && -d $aside ]]; then
		rm -rf "$PGDATA"
		checkpoint cancel-cleared
		mv "$aside" "$PGDATA"
		sync /data
		checkpoint cancel-back-unrecorded
		restore_clear
		echo "obur: the database from before the restore is back; obur starts again."
	elif [[ -n $aside ]]; then
		# Put back by an earlier cancel that stopped before it could say so.
		restore_clear
		echo "obur: the database from before the restore is back; obur starts again."
	else
		rm -rf "$PGDATA"
		restore_clear
		# Nothing was moved aside: there was no database before the restore.
		echo "obur: the restore is cancelled. There was no database before it, so obur is back to how it was then."
	fi
	rm -f "$OBUR_RUN/hold"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
start) exec /usr/local/lib/obur/obur-init ;;
setup-link)
	obur_env
	obur_node admin-setup-link.ts
	;;
recovery-link)
	obur_env
	obur_node admin-recovery-link.ts "$@"
	;;
backup)
	obur_env
	case ${1:-} in
	now) exec gosu postgres obur-backup run ;;
	pre-upgrade) exec gosu postgres obur-backup pre-upgrade ;;
	info) exec gosu postgres obur-backup info ;;
	restore-check) exec gosu postgres obur-backup restore-check ;;
	*) usage ;;
	esac
	;;
restore)
	obur_env
	sub=${1:-}
	[[ $# -gt 0 ]] && shift
	case $sub in
	start) restore_start "$@" ;;
	finish) restore_finish "$@" ;;
	cancel) restore_cancel ;;
	*) usage ;;
	esac
	;;
*) usage ;;
esac
