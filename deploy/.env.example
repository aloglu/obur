# obur settings. Copy to .env next to compose.yaml and fill in the two required values.
# This file holds the backup passphrase. If this folder is copied somewhere (a cloud drive, another backup tool),
# leave .env out of that copy, or the copy holds both the encrypted backups and their key.

# Required: the address people open (https, no path), e.g. https://obur.example.com.
PUBLIC_ORIGIN=https://obur.example.com

# Required: encrypts every backup. Use a long phrase and keep a copy off this server (a password manager): without
# it no backup can be read. Changing it later needs a fresh backup storage.
OBUR_BACKUP_PASSPHRASE=change-me

# Your time zone, for the nightly backup and other schedules. Diary days always use each person's own zone. Backups
# are named by this time: keep it the same once backups exist, also when moving to another server.
TZ=Europe/Istanbul

# Optional: the passkey domain, the address's host by default. A parent domain (example.com for obur.example.com)
# keeps everyone's passkeys if obur moves to another subdomain later. Changing it means enrolling passkeys again.
#WEBAUTHN_RP_ID=example.com

# Where obur listens on this machine. 127.0.0.1 is right with a tunnel or reverse proxy here.
#OBUR_BIND_ADDRESS=127.0.0.1
#OBUR_PORT=8040
# Where obur keeps its data and its backups, relative to this folder or absolute. Backups on another disk are safer.
#OBUR_DATA_DIR=./data
#OBUR_BACKUP_DIR=./data/backups

# Backups: how many weekly full backups to keep, and the local hour after which the nightly one runs. Deleted
# accounts remain in backups this long.
#OBUR_BACKUP_KEEP_WEEKS=5
#OBUR_BACKUP_HOUR=2

# Optional off-site copy in S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3 …). Without it, Household →
# Backups warns that a lost disk takes the backups with it. For R2 the endpoint is
# <account-id>.r2.cloudflarestorage.com and the region auto.
#OBUR_OFFSITE_TYPE=s3
#OBUR_OFFSITE_ENDPOINT=<account-id>.r2.cloudflarestorage.com
#OBUR_OFFSITE_BUCKET=obur-backups
#OBUR_OFFSITE_REGION=auto
#OBUR_OFFSITE_KEY=
#OBUR_OFFSITE_SECRET=

# Speak and Scan use the obur-speech and obur-labels add-ons. Their threads while working (default 4), and memory:
# about 1 GB for speech and 0.5 GB for labels.
#SPEECH_THREADS=4
#LABELS_THREADS=4

# Reminders work without settings: obur makes its own push keys. A server that already had keys sets them here so
# devices keep their reminders.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com
