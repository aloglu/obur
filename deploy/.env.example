# obur production settings. Copy to .env next to compose.yaml and replace every value marked change-me.
#
# This file holds the backup passphrase and storage keys. If your app-data folder is copied somewhere (a cloud
# drive, another backup tool), exclude this file from that copy, or keep it elsewhere and point your tooling at it
# (on Unraid: OBUR_ENV_FILE at the top of obur-ctl). Otherwise the copy holds the encrypted backups and their key.
#
# Passwords: use long random hex strings so they are safe inside connection URLs, e.g. `openssl rand -hex 32`.

# Public address people use (https, no path) and the passkey domain: that host or a parent domain of it.
# Changing WEBAUTHN_RP_ID later means everyone must enrol their passkeys again.
PUBLIC_ORIGIN=https://obur.example.com
WEBAUTHN_RP_ID=example.com

# Time zone for schedules (nightly backup, trash purge). Diary days always use each person's own zone.
TZ=Europe/Istanbul

# Port the web app listens on, for the reverse proxy or tunnel.
OBUR_PORT=8040

# Where data and backups live, relative to this folder or absolute.
OBUR_DATA_DIR=./data
OBUR_BACKUP_DIR=./backups

# Database passwords: superuser (setup only), schema owner (migrations), app and worker (runtime).
OBUR_ADMIN_DB_PASSWORD=change-me
OBUR_MIGRATOR_DB_PASSWORD=change-me
OBUR_APP_DB_PASSWORD=change-me
OBUR_WORKER_DB_PASSWORD=change-me

# Encrypts every backup, local and off-site. Keep a copy off this server (password manager): without it no backup
# can be restored. Changing it later needs a new backup repository.
OBUR_BACKUP_PASSPHRASE=change-me

# How many weekly full backups to keep (with everything needed to restore to any moment between them). Deleted
# accounts can remain in backups for this long.
OBUR_BACKUP_KEEP_WEEKS=5
# Local hour after which the nightly backup runs.
OBUR_BACKUP_HOUR=2

# Optional off-site copy in S3-compatible storage (e.g. Cloudflare R2). Leave OBUR_OFFSITE_TYPE empty for local
# backups only; the admin page then warns that there is no off-site copy.
# For R2: the endpoint is https://<account-id>.r2.cloudflarestorage.com without the https:// part, region auto.
OBUR_OFFSITE_TYPE=
OBUR_OFFSITE_ENDPOINT=<account-id>.r2.cloudflarestorage.com
OBUR_OFFSITE_BUCKET=change-me
OBUR_OFFSITE_REGION=auto
OBUR_OFFSITE_KEY=change-me
OBUR_OFFSITE_SECRET=change-me

# Speak (speech to text). On by default with the speech service in compose.yaml; set SPEECH_URL= (empty) to switch it
# off. The speech service uses up to SPEECH_THREADS CPU threads while transcribing (default 4) and about 1 GB of memory.
#SPEECH_URL=
#SPEECH_THREADS=4
# Scan a label (reading nutrition tables). On by default with the OCR service in compose.yaml; set OCR_URL= (empty) to
# switch it off. It uses up to OCR_THREADS CPU threads while reading (default 4) and about 0.5 GB of memory.
#OCR_URL=
#OCR_THREADS=4

# Reminders (opt-in, per person; docs/design.md "Reminders"). Off until these three are set: generate them with
# `npm run push:keys`. Notifications reach phones through their push service (Apple's for iPhones), with encrypted
# content. Changing the keys later means everyone turns reminders on again. VAPID_SUBJECT is a contact for the push
# services, e.g. mailto:you@example.com.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=
