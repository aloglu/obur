#!/bin/bash
# obur-ctl: the only program the obur deploy key may run on this server. The key's entry in authorized_keys forces
# this script (command="..."), so whatever the caller types arrives here as SSH_ORIGINAL_COMMAND and is checked
# against the fixed list of actions below. There is no shell, file access, database console or delete action.
#
# What the actions can touch: Docker images named obur, obur-speech and obur-labels (built here from the uploaded
# source and tagged candidate, current and previous) and the containers of the Compose project "obur", defined by
# $OBUR_DIR/compose.yaml. That file decides what the containers may mount; keep it and this
# script where the deploy key cannot write (both are root-owned, outside obur-lab), and review changes to either.
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

# Settings ---------------------------------------------------------------------------------------------------------
# The Compose project: compose.yaml, the database, the backups.
OBUR_DIR=/mnt/user/appdata/obur
# The settings file with secrets. It may live elsewhere, e.g. /boot/config/obur/.env, if your appdata backups go
# somewhere you would not want the backup passphrase and storage keys.
OBUR_ENV_FILE="$OBUR_DIR/.env"
export OBUR_ENV_FILE
# Where the assistant uploads the source to build (inside obur-lab's own folder).
OBUR_SOURCE=/mnt/user/appdata/obur-lab/deploy/source
# ------------------------------------------------------------------------------------------------------------------

SERVICES='obur|obur-speech|obur-labels'
IMAGES='obur obur-speech obur-labels'

say() { printf '%s\n' "$*"; }
fail() {
	say "obur-ctl: $*" >&2
	exit 2
}
usage() {
	cat <<'USAGE'
obur-ctl actions:
  status                    containers and obur images
  logs <obur|obur-speech|obur-labels> [n]  last n log lines (default 200, at most 2000)
  build                     build obur, obur-speech and obur-labels candidates from the uploaded source
  deploy                    back up, switch to the candidate images and start (the obur container upgrades itself)
  rollback                  switch back to the images before the last deploy and start (the database stays as is)
  restart <obur|obur-speech|obur-labels>   restart one container
  stop                      stop the containers (data is kept)
  backup                    run a backup now
  backup-info               list backups
  restore-check             restore backup + archived WAL into a throwaway database and verify it
USAGE
}

# Locally built images (obur:current …) rather than the published ones.
compose() {
	OBUR_REGISTRY='' OBUR_VERSION=current \
		docker compose --project-name obur --project-directory "$OBUR_DIR" \
		-f "$OBUR_DIR/compose.yaml" --env-file "$OBUR_ENV_FILE" "$@"
}

has_image() { docker image inspect "$1" >/dev/null 2>&1; }

running() { [[ $(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null) == true ]]; }

# Containers of the project that the current compose.yaml no longer defines (the layout before the single obur
# container: db, web, worker, speech, ocr). They are stopped before anything starts, so two databases never run on
# the same files.
stop_old_layout() {
	local id service
	for id in $(docker ps -q --filter label=com.docker.compose.project=obur); do
		service=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' "$id")
		[[ $service =~ ^($SERVICES)$ ]] || docker stop -t 60 "$id" >/dev/null
	done
}

source_dir() {
	[[ -d $OBUR_SOURCE && ! -L $OBUR_SOURCE ]] || fail "no source at $OBUR_SOURCE"
	local real
	real=$(realpath -e "$OBUR_SOURCE")
	[[ $real == /mnt/user/appdata/obur-lab/deploy/* ]] || fail "source resolves outside obur-lab: $real"
	[[ -f $real/Dockerfile && -f $real/speech/Dockerfile && -f $real/labels/Dockerfile ]] ||
		fail "source has no Dockerfiles"
	printf '%s' "$real"
}

# Parse: words of lowercase letters, digits and dashes only.
read -r -a args <<<"${SSH_ORIGINAL_COMMAND:-help}"
for word in "${args[@]}"; do
	[[ $word =~ ^[a-z0-9-]{1,20}$ ]] || fail "refused: only simple words are accepted"
done
(( ${#args[@]} <= 3 )) || fail "refused: too many words"
action=${args[0]:-help}
logger -t obur-ctl "action: ${args[*]:-help}" 2>/dev/null || true

[[ -f $OBUR_DIR/compose.yaml || $action == help ]] || fail "missing $OBUR_DIR/compose.yaml"
[[ -f $OBUR_ENV_FILE || $action == help ]] || fail "missing $OBUR_ENV_FILE"

# One action at a time.
exec 9>/tmp/obur-ctl.lock
flock -w 600 9 || fail "another action is still running"

case $action in
help) usage ;;
status)
	compose ps
	docker image ls --format '{{.Repository}}:{{.Tag}}  {{.ID}}  {{.CreatedSince}}' |
		grep -E '^obur(-speech|-labels)?:' || true
	;;
logs)
	service=${args[1]:-}
	lines=${args[2]:-200}
	[[ $service =~ ^($SERVICES)$ ]] || fail "logs needs one of: ${SERVICES//|/, }"
	[[ $lines =~ ^[0-9]{1,4}$ ]] && ((lines >= 1 && lines <= 2000)) || fail "lines must be 1-2000"
	compose logs --no-color --tail "$lines" "$service"
	;;
build)
	src=$(source_dir)
	docker build --pull -t obur:candidate "$src"
	docker build --pull -t obur-speech:candidate "$src/speech"
	docker build --pull -t obur-labels:candidate "$src/labels"
	;;
deploy)
	for image in $IMAGES; do has_image "$image:candidate" || fail "build first"; done
	# A backup before any switch, from whichever layout is running (none on the very first start).
	if running obur; then
		docker exec obur obur backup pre-upgrade
	elif running obur-db-1; then
		docker exec obur-db-1 gosu postgres obur-backup pre-upgrade
	fi
	for image in $IMAGES; do
		if has_image "$image:current"; then docker tag "$image:current" "$image:previous"; fi
		docker tag "$image:candidate" "$image:current"
	done
	stop_old_layout
	compose up -d --wait --wait-timeout 600 --remove-orphans
	compose ps
	;;
rollback)
	has_image obur:previous || fail "nothing to roll back to"
	for image in $IMAGES; do
		# An image may have no previous version yet (first deploy with it): keep the current one.
		if has_image "$image:previous"; then docker tag "$image:previous" "$image:current"; fi
	done
	compose up -d --wait --wait-timeout 600 --remove-orphans
	compose ps
	;;
restart)
	service=${args[1]:-}
	[[ $service =~ ^($SERVICES)$ ]] || fail "restart needs one of: ${SERVICES//|/, }"
	compose restart "$service"
	;;
stop) compose stop ;;
backup) docker exec obur obur backup now ;;
backup-info) docker exec obur obur backup info ;;
restore-check) docker exec obur obur backup restore-check ;;
*)
	usage >&2
	fail "unknown action: $action"
	;;
esac
