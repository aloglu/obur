# Throwaway image for converting PaddlePaddle models to ONNX (Phase 0 only).
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --only-binary=:all: paddlepaddle==3.3.0 paddle2onnx==2.1.0 pyyaml packaging && pip freeze > /versions.txt
