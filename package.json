{
	"name": "obur",
	"private": true,
	"version": "1.0.0-beta.3",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "./scripts/e2e-docker.sh",
		"db:start": "docker compose up -d db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env scripts/migrate.ts",
		"db:stop": "docker compose stop db",
		"test:e2e:local": "playwright test --project desktop-chromium",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"db:bootstrap": "node --env-file=.env scripts/db-bootstrap.ts",
		"test:db": "vitest run --project db",
		"admin:setup-link": "node --env-file=.env scripts/admin-setup-link.ts",
		"admin:recovery-link": "node --env-file=.env scripts/admin-recovery-link.ts",
		"jobs:setup": "node --env-file=.env scripts/jobs-setup.ts",
		"curated:build": "node scripts/curated-build.ts",
		"curated:load": "node --env-file=.env scripts/curated-load.ts",
		"worker": "node --env-file=.env scripts/worker.ts",
		"push:keys": "node scripts/push-keys.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/web-push": "3.6.4",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	},
	"dependencies": {
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.3",
		"drizzle-orm": "0.45.4",
		"fflate": "0.8.3",
		"layerchart": "2.8.0",
		"pg-boss": "12.38.0",
		"postgres": "3.4.9",
		"valibot": "^1.5.0",
		"web-push": "3.6.7"
	}
}
